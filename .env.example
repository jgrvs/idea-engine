# Copy to .env.local and fill in. Next.js loads .env.local automatically.

# Your Anthropic prepaid API key (sk-ant-...)
ANTHROPIC_API_KEY=

# Absolute path where generated prototypes are written.
# Windows example:  C:\dev\Repositories\prototypes
# Linux example:    /srv/idea-engine/prototypes
# macOS example:    /Users/you/repos/prototypes
# If unset, defaults to a `prototypes` folder sibling to this project.
SANDBOX_PATH=
